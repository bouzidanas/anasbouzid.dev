{
  "name": "anasbouzid-dev",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-13",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "anasbouzid.dev", "custom_domain": true },
    { "pattern": "www.anasbouzid.dev", "custom_domain": true },
  ],
}
