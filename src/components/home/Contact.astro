---
import { resumeRequest } from "../../lib/contact";
import CopyEmail from "../CopyEmail.astro";

const heading = [..."Let's talk."];
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 id="contact-title" class="swell">
      <span class="visually-hidden">Let's talk.</span>
      <span aria-hidden="true">
        {heading.map((character, i) => (
          <span
            data-i={i}
            style={`--i: ${i}`}
            set:text={character === " " ? "\u00a0" : character}
          />
        ))}
      </span>
    </h2>
    <p class="note">
      I'm looking for frontend and full-stack roles, remote or on-site. I'm based in Lincoln,
      Nebraska, and happy to relocate.
    </p>
    <CopyEmail />
    <ul class="links" role="list">
      <li>
        <a class="button" href={resumeRequest}>
          Request my résumé
        </a>
      </li>
      <li>
        <a class="external" href="https://github.com/bouzidanas">
          GitHub
        </a>
      </li>
      <li>
        <a class="external" href="https://www.linkedin.com/in/bouzidanas/">
          LinkedIn
        </a>
      </li>
    </ul>
  </div>
</section>

<script>
  import { keepKerning } from "../../lib/kerning";
  import { swell } from "../../lib/swell";

  const heading = document.querySelector<HTMLElement>("#contact-title")!;
  const { wave } = swell(heading);

  // Once the font is in: the kerning back, then a wave through the letters the first time the heading is in view.
  void document.fonts.ready.then(() => {
    keepKerning(heading);
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        wave();
        observer.disconnect();
      },
      { threshold: 0.9 },
    );
    observer.observe(heading);
  });
</script>

<style>
  .contact .wrap {
    display: grid;
    gap: 1.25rem;
    padding-bottom: clamp(4rem, 10vw, 7rem);
  }

  h2 {
    font-size: clamp(3.5rem, 2rem + 8vw, 9rem);
    font-weight: 350;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .note {
    max-width: 44ch;
    margin-bottom: 1rem;
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: 0.5rem;
  }
</style>
