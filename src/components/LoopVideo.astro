---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string;
  poster: ImageMetadata;
  label: string;
}

const { src, poster, label } = Astro.props;
const posterImage = await getImage({ src: poster, width: 960, format: "webp" });
---

<video
  class="loop-video"
  src={src}
  poster={posterImage.src}
  width={poster.width}
  height={poster.height}
  aria-label={label}
  muted
  loop
  playsinline
  preload="none"
></video>

<script>
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");

  // Play only while on screen, and not at all for people who asked for less motion.
  const observer = new IntersectionObserver((entries) => {
    for (const { target, isIntersecting } of entries) {
      const video = target as HTMLVideoElement;
      if (isIntersecting && !reduceMotion.matches) video.play().catch(() => {});
      else video.pause();
    }
  });

  document
    .querySelectorAll<HTMLVideoElement>(".loop-video")
    .forEach((video) => observer.observe(video));
</script>

<style>
  .loop-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
