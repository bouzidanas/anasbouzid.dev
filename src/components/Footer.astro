---
import PixelField from "./PixelField.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <PixelField />
  <div class="wrap row">
    <p>© {year} Anas Bouzid</p>
    <p>
      Built with Astro, SolidJS and <a href="/work/rhp/">rhp</a>.
    </p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: var(--step--1);
  }

  /* From the footer's rule to the bottom of the page. */
  .footer :global(.pixel-field) {
    top: -1px;
    height: calc(100% + 1px);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 2rem;
  }
</style>
